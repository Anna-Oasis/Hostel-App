{
  "cli": {
    "version": ">= 16.6.2",
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development",
      "android" : {
        "buildType" : "app-bundle"
      }
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview",
      "android" : {
        "buildType" : "app-bundle"
      }
    },
    "production": {
      "autoIncrement": true,
      "channel": "production",
      "android" : {
        "buildType" : "app-bundle"
      }
    }
  },
  "submit": {
    "production": {}
  }
}